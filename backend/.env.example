# AWS — COG base layers, watersheds, and per-project media/packages in S3
# Bucket layout:
#   rasters/*.tif                  — shared COG raster layers
#   vector/*.fgb|*.gpkg            — shared secondary vectors + watershed boundaries
#   {project_id}/media/{file}      — field note photos/videos
#   {project_id}/packages/{...}    — QField package artifacts per project
#
# IAM user needs at least:
#   s3:GetObject, s3:PutObject, s3:DeleteObject on arn:aws:s3:::your-bucket/*
#   (or scoped to arn:aws:s3:::your-bucket/*/media/* and .../packages/*)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Comma-separated COG keys under rasters/
COG_LAYERS=rasters/lulc250k_2023_24_classed_cog.tif,rasters/dem_india.tif,rasters/jrc_occurrence_india_2024.tif,rasters/jrc_transition_india_2024.tif

# Comma-separated FlatGeobuf vector layer keys under vector/
# Irrigation / kharif / rabi WISER layers share village_resilience.fgb
VECTOR_LAYERS=vector/aquifers.fgb,vector/gw_stress.fgb,vector/village_resilience.fgb,vector/villages.fgb

# Watershed boundaries under vector/
WATERSHEDS_FGB_KEY=vector/india_basins_level_12.gpkg

# PostGIS — public host QField can reach (NOT localhost for mobile sync)
POSTGIS_PUBLIC_HOST=your-server.example.com
POSTGIS_PUBLIC_PORT=5432

# QField Cloud — each user connects their own account via the Profile page
QFIELD_CLOUD_URL=https://app.qfield.cloud/api/v1/
QFIELD_PROJECT_NAME=dda-diagnose

# QField package rasters — watershed-clipped MBTiles zoom range (smaller = less quota)
QFIELD_RASTER_MIN_ZOOM=8
QFIELD_RASTER_MAX_ZOOM=16
QFIELD_RASTER_MAX_PIXELS=2048

# Database (local dev defaults match docker-compose)
DATABASE_URL=postgresql://geofield:geofield@localhost:5432/dda_product

# Titiler (local dev)
TITILER_URL=http://localhost:8000

# Auth — CORS origin, cookie session, FastAPI Users JWT, Brevo, Google OAuth
# Local browser entrypoint is Vite on http://localhost:5173 (or :5174 if busy).
# Do not point the browser at :8080 — use the Vite app; /api is proxied.
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
AUTH_JWT_SECRET=change-me-in-production-use-32plus-chars
# Backend listen URL (Docker/server-side only). Browsers use FRONTEND_ORIGIN + /api.
API_PUBLIC_URL=http://localhost:8080

# Brevo transactional email (optional locally — emails logged/skipped if unset)
# If API returns 401 "unrecognised IP address", add your public IP (or disable
# IP restriction) at https://app.brevo.com/security/authorised_ips
# Sender must be a verified Brevo sender. Prefer a domain authenticated in
# Brevo (SPF/DKIM). Sending as *@ifmr.ac.in via Brevo will soft-bounce under
# IFMR DMARC — use e.g. noreply@welllabs.org instead.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@welllabs.org
BREVO_SENDER_NAME=Water Security Tool

# Google OAuth (optional — Sign in / Sign up with Google omitted if unset)
# Authorized redirect URIs in Google Cloud Console (add both Vite ports):
#   http://localhost:5173/api/accounts/auth/google/callback
#   http://localhost:5174/api/accounts/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ODK Central Configuration
ODK_BASE_URL=https://odk.example.com/
ODK_USERNAME=
ODK_PASSWORD=

# Metabase signed (guest) embedding
METABASE_EMBEDD_SECRET_KEY=   # Embedding secret key from Metabase Admin > Embedding
METABASE_PUBLIC_URL=http://localhost:3000   # Browser-reachable Metabase URL
