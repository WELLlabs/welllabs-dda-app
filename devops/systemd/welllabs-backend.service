[Unit]
Description=Water Security Toolbox API (Uvicorn / FastAPI)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=root
Group=root
WorkingDirectory=/opt/welllabs/current/backend
EnvironmentFile=/opt/welllabs/shared/.env
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/welllabs/current/backend/venv/bin/uvicorn \
    app.main:app \
    --host 127.0.0.1 \
    --port 8080 \
    --workers 2 \
    --proxy-headers \
    --forwarded-allow-ips=* \
    --timeout-keep-alive 75 \
    --access-log \
    --log-level info

ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=5

# Cold import (GDAL/rasterio) + 2 workers can exceed the default 90s start budget
# on a thrashing host after a failed deploy — that fails CodeDeploy health.
TimeoutStartSec=180
# Packaging / QField sync can be long-running
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
